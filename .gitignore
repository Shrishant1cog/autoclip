# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv
uv.lock

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Built frontend, emitted into the Python package by `npm run build`.
# Regenerated from source; a release build produces it during packaging.
backend/autoclip/static/

# AutoClip runtime artifacts
.autoclip/
*.db
*.sqlite3

# Local source downloads (`ingest.download_dir`)
materials/

# Test media (large binaries stay out of git; see tests/fixtures/README.md)
tests/fixtures/media/
tests/fixtures/**/*.mp4
tests/fixtures/**/*.mkv
tests/fixtures/**/*.webm
tests/fixtures/**/*.wav

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
# Windows shortcuts carry an absolute path to the machine that made them.
*.lnk

# Secrets — never commit
.env
.env.*
!.env.example

# Branch archives. These are full working copies of the repository — they
# duplicate the git history, carry the user's media, and are never committed.
All-Branches/
*.zip
*.7z
